# Live config: /opt/netns-singbox/env

# Namespace name (bind-mount at /run/netns/$NETNS_NAME for runns(1)).
NETNS_NAME=agent

# veth: host side stays in init netns, peer moves into $NETNS_NAME.
VETH_HOST=veth-agent-h
VETH_NS=veth-agent

# Link to host where Docker publishes sing-box SOCKS (happ-sing-box: 1080/tcp).
HOST_GW=10.252.0.1
NS_GW=10.252.0.2
VETH_CIDR=10.252.0.0/30

SOCKS_HOST=10.252.0.1
SOCKS_PORT=1080

# tun2socks --fwmark (decimal). Must match nft SOCKS_ROUTING_MARK (0x1337 = 4919).
SOCKS_FWMARK=4919
SOCKS_ROUTING_MARK=0x1337

# TUN inside the namespace (tun2socks reads/writes this device).
TUN_DEVICE=tun0
TUN_ADDR=198.18.0.1/15
TUN_GW=198.18.0.1

# https://github.com/xjasonlyu/tun2socks/releases — install next to netns-singbox binary
TUN2SOCKS_BIN=/opt/netns-singbox/bin/tun2socks
TUN2SOCKS_LOGLEVEL=info
TUN2SOCKS_MTU=0

# Full proxy URL overrides SOCKS_HOST/SOCKS_PORT (tun2socks: socks5 only, not socks5h).
# TUN2SOCKS_PROXY=socks5://10.252.0.1:1080

# Written to /etc/netns/$NETNS_NAME/ for runns(1) (resolv.conf + nsswitch.conf).
# resolv.conf uses options use-vc (TCP DNS) — tun2socks path is TCP-friendly; SOCKS UDP needs extra publish.
NETNS_NAMESERVERS=1.1.1.1,8.8.8.8

# Account that may run `runns $NETNS_NAME -- cmd` without sudo (username or uid).
# Empty: only root. While the service is up, the uid is written to
# /run/netns-singbox/$NETNS_NAME.user. runns must have cap_sys_admin
# (`sudo setcap cap_sys_admin+ep /usr/local/bin/runns`, or `sudo task install` in runns/).
# The command keeps this uid; capabilities are cleared before exec, so it cannot
# change nftables or routes. The namespace stays owned by root on purpose.
# NETNS_USER=
